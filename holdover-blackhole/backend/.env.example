DATABASE_URL=sqlite:///./storage/blackhole.db
JWT_SECRET=replace-with-a-strong-random-secret-of-32-bytes-or-more
ALLOW_DEV_AUTH=true
OBJECT_STORAGE_ROOT=./storage
BLACKHOLE_ROUTER_MODEL=gpt-4.1-mini
BLACKHOLE_TRANSCRIPTION_MODEL=whisper-1
BLACKHOLE_AUTO_ROUTE_THRESHOLD=0.80
BLACKHOLE_AUDIO_RETENTION_HOURS=24
BLACKHOLE_SEARCH_DEFAULT_LIMIT=20
BLACKHOLE_SEARCH_MAX_LIMIT=50
OPENAI_API_KEY=

