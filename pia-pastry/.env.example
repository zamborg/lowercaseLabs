# Target
PIA_STORE_URL=https://www.hotplate.com/butterandcrumble
PIA_EVENT_URL=

# Exact preference order. Add ",Large Pastry Box" only if that fallback is wanted.
PIA_PRODUCTS=Small Pastry Box
PIA_QUANTITY=1
PIA_PICKUP_PREFERENCES=Thursday,Thu,Friday,Fri,Saturday,Sat,Sunday,Sun
PIA_PICKUP_TIME_PREFERENCES=
# If configured preferences do not match, pick a random short date/time control.
PIA_RANDOM_PICKUP=true

# dry-run = observe; assist = reach final review and ring; auto = guarded final click.
PIA_MODE=assist
PIA_MAX_TOTAL_DOLLARS=40

# Required verbatim for auto mode. Deliberately blank by default.
PIA_AUTO_PURCHASE_ACK=

# Start the process before this instant. It sleeps until 45 seconds before release.
# Example: 2026-08-04T12:00:00-07:00
PIA_RELEASE_AT=
PIA_LEAD_SECONDS=45
PIA_POLL_MS=2500
PIA_POLL_JITTER_MS=350

# A dedicated persistent browser profile is used; secrets do not belong in this file.
PIA_BROWSER_CHANNEL=chromium
PIA_HEADLESS=false
PIA_PROFILE_DIR=.pia-profile
PIA_ARTIFACT_DIR=artifacts
