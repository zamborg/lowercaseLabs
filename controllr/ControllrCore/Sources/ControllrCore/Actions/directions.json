{
  "id": "directions",
  "kind": "native",
  "description": "Open Apple Maps with directions to a destination.",
  "params": [
    {
      "name": "destination",
      "type": "string",
      "description": "Place or address; the word 'home' means the saved home address",
      "required": true,
      "missingQuestion": "Where are you headed?"
    },
    {
      "name": "mode",
      "type": "oneOf",
      "description": "Travel mode; default drive",
      "required": false,
      "values": [
        "drive",
        "walk",
        "transit"
      ]
    }
  ],
  "requiresConfirmation": false,
  "summary": "Directions to {destination}",
  "evals": [
    {
      "utterance": "directions to the airport"
    },
    {
      "utterance": "how do I get home"
    },
    {
      "utterance": "walk to the nearest starbucks"
    },
    {
      "utterance": "navigate to 1 infinite loop"
    },
    {
      "utterance": "To the Oakland airport, walking",
      "history": [
        {
          "role": "user",
          "text": "Give me directions"
        },
        {
          "role": "assistant",
          "text": "Where are you headed?"
        }
      ],
      "arguments": {
        "mode": "walk"
      }
    }
  ]
}
