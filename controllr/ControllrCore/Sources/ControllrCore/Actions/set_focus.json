{
  "id": "set_focus",
  "kind": "shortcut",
  "description": "Turn a Focus mode on or off.",
  "params": [
    {
      "name": "focus",
      "type": "oneOf",
      "description": "Which focus to set; 'off' turns focus off",
      "required": true,
      "values": [
        "dnd",
        "sleep",
        "work",
        "off"
      ]
    }
  ],
  "requiresConfirmation": false,
  "summary": "Focus: {focus}",
  "shortcutHandler": "focus",
  "evals": [
    {
      "utterance": "do not disturb on"
    },
    {
      "utterance": "turn on sleep focus"
    },
    {
      "utterance": "turn off focus"
    }
  ]
}
