ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sovereign_store
REDIS_URL=redis://localhost:6379/0

# JWT configuration (recommended for production)
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Local fallback for HS256 mode
# JWT_ALGORITHM=HS256
# JWT_SECRET=replace-me

CONTROL_PLANE_URL=http://localhost:8000
EDGE_ROUTER_URL=http://localhost:8001
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8081,http://127.0.0.1:8081
GATEWAY_SESSION_COOKIE_NAME=sovereign_gateway_token
GATEWAY_SESSION_COOKIE_DOMAIN=
GATEWAY_SESSION_COOKIE_SECURE=false
GATEWAY_SESSION_COOKIE_SAMESITE=lax
GATEWAY_SESSION_COOKIE_MAX_AGE_SECONDS=3600
GATEWAY_SESSION_COOKIE_PATH=/

FLY_API_BASE_URL=https://api.machines.dev
FLY_API_TOKEN=replace-me
FLY_DEFAULT_REGION=sjc
FLY_ORG_SLUG=replace-me
MACHINE_CPU_KIND=shared
MACHINE_CPUS=1
MACHINE_MEMORY_MB=256
MACHINE_VOLUME_SIZE_GB=1

# Optional local parser guardrail:
# Restrict /apps/charts/parse repo_path to this root directory.
# DEVELOPER_REPO_ROOT=/Users/you/dev

# Optional remote repo parsing controls:
REPO_CLONE_ROOT=/tmp/sovereign-chart-clones
REPO_CLONE_TIMEOUT_SECONDS=120
# Optional comma-separated host allowlist:
# REPO_ALLOWED_HOSTS=github.com,gitlab.com
