# ZOS local/OrbStack environment template (copy to .env; .env is gitignored)
ZOS_PORT=8787
ZOS_BASE_URL=http://localhost:8787
POSTGRES_USER=zos
POSTGRES_PASSWORD=zos
POSTGRES_DB=zos

# 32-byte base64 key for encrypting Google OAuth credentials (M4)
# Generate: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ZOS_SECRET_KEY=

# Argon2id hash of owner passphrase for /oauth/authorize and /connect/google
# Generate: uv run zos hash-password
ZOS_OWNER_PASSWORD_HASH=

# Google OAuth Web client credentials (optional until connecting Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
