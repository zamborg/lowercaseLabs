# ZOS environment template (copy to .env; .env is gitignored; chmod 600 .env)

# HTTP port bound on 127.0.0.1 and public base URL (https://zos.<your-domain> behind a tunnel)
ZOS_PORT=8787
ZOS_BASE_URL=http://localhost:8787
ZOS_LOG_LEVEL=INFO

# Postgres bootstrap superuser (used only by Postgres container init)
POSTGRES_USER=zos
POSTGRES_PASSWORD=zos
POSTGRES_DB=zos

# Restricted non-superuser Postgres role used by ZOS core (CREATEROLE + owner of POSTGRES_DB/public).
# On fresh deployments, deploy/postgres/01-init-app-role.sh creates this role automatically.
# Leave commented on pre-M11 volumes unless you have migrated ownership to zos_app.
# ZOS_DB_USER=zos_app
# ZOS_DB_PASSWORD=

# Direct DATABASE_URL override (used when running outside Docker Compose or against hosted Postgres)
# DATABASE_URL=postgresql://zos_app:<password>@<host>:5432/zos

# 32-byte urlsafe base64 key for AES-256-GCM credential & pending-approval encryption
# Generate: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ZOS_SECRET_KEY=

# Argon2id hash of owner passphrase for /admin/login, /oauth/authorize, and /connect/*
# Wrap in single quotes so Docker Compose does not expand '$' characters!
# Generate: uv run zos hash-password
ZOS_OWNER_PASSWORD_HASH=''

# Google OAuth Web client credentials (optional until connecting Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Google Calendar backend override: api | mcp (can also be toggled live on /admin)
# ZOS_GCAL_BACKEND=
# ZOS_GCAL_MCP_URL=

# Comma-separated external HTTPS redirect hosts allowed at /oauth/register (DCR).
# Loopback hosts (localhost, 127.0.0.1, ::1) are always allowed.
# Default is empty (loopback only). For ChatGPT connectors, set: chatgpt.com
ZOS_ALLOWED_REDIRECT_HOSTS=

# Optional DCR abuse caps (defaults: 10 registrations/hour, 50 total OAuth clients)
# ZOS_DCR_MAX_PER_HOUR=10
# ZOS_MAX_OAUTH_CLIENTS=50

# Async approval wait timeout & TTL in seconds for clients without MCP elicitation
# ZOS_APPROVAL_WAIT_S=45
# ZOS_APPROVAL_TTL_S=600

# Optional comma-separated policy engine import paths (module:attr), empty by default.
# Example: ZOS_POLICY_ENGINES=zos.policy.guards:deny_rm_in_shell
# ZOS_POLICY_ENGINES=
# Per-engine timeout in seconds (default: 10); timeouts/errors escalate to human approval
# ZOS_POLICY_ENGINE_TIMEOUT_S=10

# Module runtime backend: docker | manual (default: docker when ZOS_DOCKER_SOCKET exists, else manual)
# ZOS_MODULE_HOST=
# ZOS_DOCKER_SOCKET=/var/run/docker.sock
# ZOS_MODULE_MEMORY_BYTES=268435456
# ZOS_MODULE_NETWORK_INTERNAL=zos_modules
# ZOS_MODULE_NETWORK_EGRESS=zos_modules_egress
# ZOS_MODULE_CONTAINER_PREFIX=zos-mod

# Optional directory overrides (defaults are baked into the container image under /app/)
# ZOS_MIGRATIONS_DIR=
# ZOS_CATALOG_DIR=
# ZOS_MODULES_CATALOG_DIR=

# Optional path to override MCP InitializeResult instructions text
# ZOS_INSTRUCTIONS_FILE=

# Passphrase/key for encrypting nightly pg_dump backups (deploy/backup/backup.sh)
# Generate: python3 -c "import os, base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ZOS_BACKUP_KEY=
# Optional backup destination directory, retention count, and post-backup upload hook
# (e.g. ZOS_BACKUP_POST_HOOK='aws s3 cp "$ZOS_BACKUP_FILE" s3://my-bucket/zos-backups/')
# ZOS_BACKUP_DIR=
# ZOS_BACKUP_RETAIN=14
# ZOS_BACKUP_POST_HOOK=
