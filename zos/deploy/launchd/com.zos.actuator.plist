<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zos.actuator</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.zos-actuator/venv/bin/zos-device</string>
    <string>--config</string>
    <string>{{HOME}}/.zos-actuator/config.toml</string>
    <string>--</string>
    <string>{{HOME}}/.zos-actuator/venv/bin/python</string>
    <string>-m</string>
    <string>zos_mac</string>
    <string>--config</string>
    <string>{{HOME}}/.zos-actuator/config.toml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/zos-actuator.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/zos-actuator.err.log</string>
</dict>
</plist>
