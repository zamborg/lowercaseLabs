<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zos.tmux</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{TMUX_BIN}}</string>
    <string>-L</string>
    <string>zos</string>
    <string>new-session</string>
    <string>-A</string>
    <string>-D</string>
    <string>-s</string>
    <string>zos</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/zos-tmux.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/zos-tmux.err.log</string>
</dict>
</plist>
