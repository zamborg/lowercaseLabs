# Declarative Cloudflare Named Tunnel config template for ZOS (locally-managed tunnel).
# Copy to ~/.cloudflared/config.yml and fill in <TUNNEL-UUID>, <HOME>, and zos.<your-domain>.
# NEVER commit your real tunnel credentials JSON or ~/.cloudflared/config.yml.
#
# Strict ingress allowlist (mirrors deploy/caddy/Caddyfile.allowlist):
#   - Allowed publicly (behind optional Cloudflare Access on browser paths):
#       /mcp, /mcp/*, /.well-known/*, /oauth/*, /admin, /admin/*, /connect/*, /actuator (WebSocket)
#   - Blocked (404) from public internet:
#       /healthz (local health check only)
#       everything else

tunnel: <TUNNEL-UUID>
credentials-file: <HOME>/.cloudflared/<TUNNEL-UUID>.json

ingress:
  - hostname: zos.<your-domain>
    path: ^/mcp($|/)
    service: http://127.0.0.1:8787

  - hostname: zos.<your-domain>
    path: ^/\.well-known/
    service: http://127.0.0.1:8787

  - hostname: zos.<your-domain>
    path: ^/oauth/
    service: http://127.0.0.1:8787

  - hostname: zos.<your-domain>
    path: ^/admin($|/)
    service: http://127.0.0.1:8787

  - hostname: zos.<your-domain>
    path: ^/connect/
    service: http://127.0.0.1:8787

  - hostname: zos.<your-domain>
    path: ^/actuator$
    service: http://127.0.0.1:8787

  # Catch-all: /healthz and all unknown paths/hosts return 404.
  - service: http_status:404
