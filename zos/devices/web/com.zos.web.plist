<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zos.web</string>
  <key>WorkingDirectory</key>
  <string>{{INSTALL_DIR}}/output</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{INSTALL_DIR}}/venv/bin/zos-device</string>
    <string>--config</string>
    <string>{{INSTALL_DIR}}/config.toml</string>
    <string>--</string>
    <string>{{NODE_BIN}}</string>
    <string>{{INSTALL_DIR}}/node_modules/@playwright/mcp/cli.js</string>
    <string>--browser</string>
    <string>chromium</string>
    <string>--user-data-dir</string>
    <string>{{INSTALL_DIR}}/profile</string>
    <string>--output-dir</string>
    <string>{{INSTALL_DIR}}/output</string>
    <string>--no-webmcp</string>
    <string>--ignore-roots</string>
    <string>--config</string>
    <string>{{INSTALL_DIR}}/playwright-mcp.json</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{NODE_DIR}}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PLAYWRIGHT_BROWSERS_PATH</key>
    <string>{{INSTALL_DIR}}/browsers</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>{{LOG_DIR}}/zos-web.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOG_DIR}}/zos-web.err.log</string>
</dict>
</plist>
