# Keep project Python pin tracked despite parent .gitignore
!.python-version

# Secrets and local environment
.env
.env.*
!.env.example
.owner-passphrase

# Local databases
*.db
*.sqlite
*.sqlite3

# Python / tool caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
